# RenCloud Backend Environment Variables
# Copy this to .env and fill in your actual values

# Pterodactyl Panel
PTERODACTYL_URL=https://panel.rencloud.online
PTERODACTYL_APP_KEY=ptla_your_application_api_key_here

# JWT Authentication
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Database (set by docker-compose, override here if needed)
DATABASE_URL=postgresql+asyncpg://rencloud:rencloud_dev_password@db:5432/rencloud

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Default currency for plans
DEFAULT_CURRENCY=INR
